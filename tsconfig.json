{
	"extends": "tsconfig-collaborne/tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"noEmit": false,
		"rootDir": "./src",
		"types": ["node", "jest"],
		"outDir": "./lib",
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib", "lib-test", "src/*/__tests__/*"]
}
